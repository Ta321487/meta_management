<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.metadata.mapper.MetadataOperationLogMapper">

    <resultMap id="BaseResultMap" type="com.metadata.entity.MetadataOperationLog">
        <id column="id" property="id"/>
        <result column="operate_user" property="operateUser"/>
        <result column="operate_type" property="operateType"/>
        <result column="operate_content" property="operateContent"/>
        <result column="operate_time" property="operateTime"/>
        <result column="status" property="status"/>
        <result column="error_msg" property="errorMsg"/>
    </resultMap>

    <insert id="insert" parameterType="com.metadata.entity.MetadataOperationLog" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO metadata_operation_log (operate_user, operate_type, operate_content, status, error_msg)
        VALUES (#{operateUser}, #{operateType}, #{operateContent}, #{status}, #{errorMsg})
    </insert>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM metadata_operation_log
        <where>
            <if test="operateUser != null and operateUser != ''">
                AND operate_user = #{operateUser}
            </if>
            <if test="operateType != null and operateType != ''">
                AND operate_type = #{operateType}
            </if>
            <if test="startTime != null and startTime != ''">
                AND operate_time &gt;= #{startTime}
            </if>
            <if test="endTime != null and endTime != ''">
                AND operate_time &lt;= #{endTime}
            </if>
        </where>
        ORDER BY operate_time DESC
    </select>

    <select id="count" resultType="Long">
        SELECT COUNT(*) FROM metadata_operation_log
        <where>
            <if test="operateUser != null and operateUser != ''">
                AND operate_user = #{operateUser}
            </if>
            <if test="operateType != null and operateType != ''">
                AND operate_type = #{operateType}
            </if>
            <if test="startTime != null and startTime != ''">
                AND operate_time &gt;= #{startTime}
            </if>
            <if test="endTime != null and endTime != ''">
                AND operate_time &lt;= #{endTime}
            </if>
        </where>
    </select>

    <select id="selectPage" resultMap="BaseResultMap">
        SELECT * FROM metadata_operation_log
        <where>
            <if test="operateUser != null and operateUser != ''">
                AND operate_user = #{operateUser}
            </if>
            <if test="operateType != null and operateType != ''">
                AND operate_type = #{operateType}
            </if>
            <if test="startTime != null and startTime != ''">
                AND operate_time &gt;= #{startTime}
            </if>
            <if test="endTime != null and endTime != ''">
                AND operate_time &lt;= #{endTime}
            </if>
        </where>
        ORDER BY operate_time DESC
        LIMIT #{pageRequest.offset}, #{pageRequest.size}
    </select>

</mapper>

